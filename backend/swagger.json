{
  "swagger": "2.0",
  "info": {
    "title": "Authentication API",
    "description": "API for user authentication",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["General"],
        "summary": "Authenticate user and get a JWT token",
        "description": "Login with your Google email to receive a JWT token",
        "operationId": "login",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "User email for authentication",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully logged in, returns JWT token.",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "400": {
            "description": "Invalid email"
          }
        }
      }
    },
    "/refresh": {
      "post": {
        "tags": ["General"],
        "summary": "Refresh JWT token",
        "description": "Provide a valid refresh token to receive a new access token",
        "operationId": "refreshToken",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Refresh token request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RefreshTokenRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully refreshed token, returns new JWT token.",
            "schema": {
              "$ref": "#/definitions/RefreshTokenResponse"
            }
          },
          "401": {
            "description": "Unauthorized if no refresh token is provided"
          },
          "403": {
            "description": "Forbidden if refresh token is invalid"
          }
        }
      }
    },   
    "/auth/google": {
      "get": {
        "tags": ["General"],
        "summary": "Redirect to Google OAuth2 login",
        "description": "Redirects the user to Google's OAuth2 login page to initiate authentication.",
        "operationId": "googleLogin",
        "responses": {
          "302": {
            "description": "Redirects to Google OAuth2 login page."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "tags": ["General"],
        "summary": "Handle OAuth2 callback from Google",
        "description": "Handles the OAuth2 callback from Google and authenticates the user.",
        "operationId": "googleCallback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "description": "Authorization code received from Google OAuth2.",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the frontend dashboard after successful authentication."
          },
          "400": {
            "description": "Authorization code not provided."
          },
          "500": {
            "description": "Authentication failed."
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": ["General"],
        "summary": "Log out the user and clear session",
